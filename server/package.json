{
  "name": "mesh-hub-server",
  "version": "1.0.0",
  "description": "",
  "author": "Mikhail Kayumov <mkmind@yandex.ru>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "tscheck": "tsc -p tsconfig.json --noEmit",
    "init-db": "node ./dist/database/utils/init-db.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/database/data.source.ts",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations/$npm_config_schema/$npm_config_name",
    "migration:generate:win": "npm run typeorm -- migration:generate ./src/database/migrations/%npm_config_schema%/%npm_config_name%",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "swagger:generate": "npm run build && node dist/swagger/generate.js",
    "swagger:generate:runtime": "node dist/swagger/generate.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "1.9.1",
    "@nestjs/common": "10.2.10",
    "@nestjs/config": "3.1.1",
    "@nestjs/core": "10.2.10",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.2",
    "@nestjs/platform-express": "10.2.10",
    "@nestjs/schedule": "4.0.0",
    "@nestjs/swagger": "7.1.16",
    "@nestjs/throttler": "5.0.1",
    "@nestjs/typeorm": "10.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "cookie-parser": "1.4.6",
    "date-fns": "2.30.0",
    "module-alias": "2.2.3",
    "nodemailer": "6.9.7",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "typeorm": "0.3.17",
    "winston": "3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.2.1",
    "@nestjs/schematics": "10.0.3",
    "@nestjs/testing": "10.2.10",
    "@types/cookie-parser": "1.4.6",
    "@types/cron": "2.0.1",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.10",
    "@types/node": "20.9.4",
    "@types/passport-jwt": "3.0.13",
    "@types/pg": "8.10.9",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "6.12.0",
    "@typescript-eslint/parser": "6.12.0",
    "eslint": "8.54.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "5.0.1",
    "jest": "29.7.0",
    "prettier": "3.1.0",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">= 18.16.0",
    "npm": ">= 9.5.1"
  }
}
