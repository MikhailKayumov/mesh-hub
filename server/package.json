{
  "name": "mesh-hub-server",
  "version": "1.0.0",
  "description": "",
  "author": "Mikhail Kayumov <mkmind@yandex.ru>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prod": "npm run db:init && npm run db:seeds && npm run start",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "tscheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "ts-node src/database/init/index.ts && npm run migration:run",
    "db:init:hard": "cross-env DROP_SCHEMAS=true ts-node src/database/init/index.ts && npm run migration:run",
    "db:seeds": "node ./dist/src/database/seeds/index.js",
    "db:build": "npm run db:init && npm run db:seeds",
    "db:build:hard": "npm run db:init:hard && npm run db:seeds",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data.source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data.source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data.source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "swagger:generate": "npm run build && node dist/swagger/generate.js",
    "swagger:generate:runtime": "node dist/swagger/generate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1034.0",
    "@aws-sdk/lib-storage": "3.1034.0",
    "@aws-sdk/s3-request-presigner": "3.1034.0",
    "@nestjs-modules/mailer": "2.3.4",
    "@nestjs/bull": "11.0.4",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.3.2",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.1",
    "adm-zip": "0.5.17",
    "bull": "4.16.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "module-alias": "2.3.4",
    "nodemailer": "8.0.5",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@types/adm-zip": "0.5.8",
    "@types/cookie-parser": "1.4.10",
    "@types/cron": "2.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.6.0",
    "@types/nodemailer": "8.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.3.0",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">= 24.11.1",
    "npm": ">= 11.6.2"
  }
}