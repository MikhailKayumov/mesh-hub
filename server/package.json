{
  "name": "mesh-hub-server",
  "version": "0.0.1",
  "description": "",
  "author": "Mikhail Kayumov",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "tscheck": "tsc -p tsconfig.json --noEmit",
    "init-db": "node ./dist/database/utils/init-db.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/database/data.source.ts",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations/$npm_config_schema/$npm_config_name",
    "migration:generate:win": "npm run typeorm -- migration:generate ./src/database/migrations/%npm_config_schema%/%npm_config_name%",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "swagger:generate": "npm run build && node dist/swagger/generate.js",
    "swagger:generate:runtime": "node dist/swagger/generate.js"
  },
  "dependencies": {
    "@nestjs/common": "10.1.3",
    "@nestjs/config": "3.0.0",
    "@nestjs/core": "10.1.3",
    "@nestjs/jwt": "10.1.0",
    "@nestjs/passport": "10.0.0",
    "@nestjs/platform-express": "10.1.3",
    "@nestjs/schedule": "3.0.2",
    "@nestjs/swagger": "7.1.8",
    "@nestjs/throttler": "^4.2.1",
    "@nestjs/typeorm": "10.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "cookie-parser": "^1.4.6",
    "date-fns": "2.30.0",
    "module-alias": "2.2.3",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "typeorm": "0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "10.1.12",
    "@nestjs/schematics": "10.0.2",
    "@nestjs/testing": "10.1.3",
    "@types/cookie-parser": "1.4.3",
    "@types/cron": "2.0.1",
    "@types/express": "4.17.17",
    "@types/jest": "29.5.3",
    "@types/node": "20.5.0",
    "@types/passport-jwt": "3.0.9",
    "@types/pg": "8.10.2",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "6.4.0",
    "@typescript-eslint/parser": "6.4.0",
    "eslint": "8.47.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.28.0",
    "eslint-plugin-prettier": "5.0.0",
    "jest": "29.6.2",
    "prettier": "3.0.2",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-loader": "9.4.4",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "_moduleAliases": {
    "@modules": "./src/modules",
    "@config": "./src/modules/common/config",
    "@decorators": "./src/decorators",
    "@guards": "./src/guards",
    "@utils": "./src/utils"
  }
}
