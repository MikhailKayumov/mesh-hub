{
  "name": "mesh-hub-server",
  "version": "1.0.0",
  "description": "",
  "author": "Mikhail Kayumov <mkmind@yandex.ru>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prod": "npm run db:init && npm run db:seeds && npm run start:prod",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "tscheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "ts-node src/database/init/index.ts && npm run migration:run",
    "db:init:hard": "cross-env DROP_SCHEMAS=true ts-node src/database/init/index.ts && npm run migration:run",
    "db:seeds": "node ./dist/database/seeds/index.js",
    "db:build": "npm run db:init && npm run db:seeds",
    "db:build:hard": "npm run db:init:hard && npm run db:seeds",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/database/data.source.ts",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations/$npm_config_schema/$npm_config_name",
    "migration:generate:win": "npm run typeorm -- migration:generate ./src/database/migrations/%npm_config_schema%/%npm_config_name%",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "swagger:generate": "npm run build && node dist/swagger/generate.js",
    "swagger:generate:runtime": "node dist/swagger/generate.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "1.11.2",
    "@nestjs/common": "10.3.7",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.7",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.3.7",
    "@nestjs/schedule": "4.0.1",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/throttler": "5.1.2",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "date-fns": "3.6.0",
    "module-alias": "2.2.3",
    "nodemailer": "6.9.13",
    "pg": "8.11.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "winston": "3.13.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.7",
    "@types/cookie-parser": "1.4.7",
    "@types/cron": "2.0.1",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/multer": "1.4.11",
    "@types/node": "20.12.5",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.11.4",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.5.0",
    "@typescript-eslint/parser": "7.5.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">= 18.16.0",
    "npm": ">= 9.5.1"
  }
}
