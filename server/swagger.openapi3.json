  "info": {
    "title": "MeshHub Swagger",
    "description": "API приложения MeshHub",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "x-access-token"
      }
    },
    "schemas": {
      "CgSoftResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UserMetaResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "aboutYourself": {
            "type": "string"
          },
          "favoriteSoft": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CgSoftResponse"
            }
          }
        },
        "required": [
          "id"
        ]
      },
      "UserCurrentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "middleName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "isConfirmed": {
            "type": "boolean"
          },
          "meta": {
            "$ref": "#/components/schemas/UserMetaResponseDto"
          }
        },
        "required": [
          "id",
          "email",
          "isConfirmed",
          "meta"
        ]
      },
      "UserCurrentUpdateRequestDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "middleName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "aboutYourself": {
            "type": "string"
          },
          "favoriteSoft": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UserResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "UserNewPasswordRequestDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "password",
          "confirmPassword"
        ]
      },
      "UserChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        },
        "required": [
          "oldPassword",
          "password",
          "confirmPassword"
        ]
      },
      "SignupRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "firstName",
          "password",
          "confirmPassword"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "userAgent": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "ip"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
